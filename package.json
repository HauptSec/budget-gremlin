{
  "name": "budget-gremlin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch apps/api/main.ts\" \"vite --host 127.0.0.1\"",
    "dev:api": "tsx watch apps/api/main.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx apps/api/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "setup": "tsx scripts/manage.ts setup",
    "seed": "tsx scripts/manage.ts seed",
    "backup": "tsx scripts/manage.ts backup",
    "restore": "tsx scripts/manage.ts restore",
    "openapi": "tsx scripts/manage.ts openapi",
    "lint": "eslint apps packages scripts tests",
    "format": "prettier --write apps packages scripts tests *.ts *.json *.js *.yaml",
    "bench": "node --import tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.4",
    "@fastify/swagger": "9.8.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-query": "5.103.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.2",
    "fastify": "5.12.5",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.6",
    "eslint": "10.10.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
