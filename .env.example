PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=data/budget-gremlin.sqlite
# Required for connectors and encrypted backups: 32 random bytes in hex.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Set true with HTTPS in deployment. Never disable for remotely accessible HTTP.
SECURE_COOKIES=false
BACKUP_DIR=backups

# Docker deployment: set these to the private server address/origin.
# LAN_IP=192.168.1.50
# APP_ORIGIN=https://192.168.1.50
